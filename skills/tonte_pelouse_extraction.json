{
  "id": "tonte_pelouse_extraction",
  "objectif": "Extraire et normaliser les informations utiles a l'estimation de tonte depuis un texte libre.",
  "inputs": [
    "texte_demande"
  ],
  "regles": [
    "Ne rien inventer",
    "Normaliser les unites en m2 et h",
    "m2 = metre carre ; h = heure",
    "Si donnee absente: null",
    "Repondre uniquement en JSON valide"
  ],
  "output_json": {
    "type_tache": "tonte_pelouse",
    "surface_m2": "number|null",
    "morcellement": "plein|morcele|eclate|null",
    "encombrement": "libre|encombre|null",
    "pente": "faible|moyenne|forte|null",
    "hauteur_herbe_cm": "number|null",
    "humidite_sol": "sec|normal|humide|null",
    "finition_bordures": "oui|non|null",
    "evacuation": "oui|non|null",
    "acces": "tres_facile|facile|moyen|difficile|null",
    "adventices": "faible|moyen|fort|null",
    "frequence_entretien": "hebdo|bi_mensuel|mensuel|ponctuel|null",
    "contraintes": [
      "string"
    ],
    "questions_bloquantes": [
      "string"
    ],
    "questions_recommandees": [
      "string"
    ]
  }
}
