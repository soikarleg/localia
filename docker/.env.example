# Copier ce fichier en .env et adapter les valeurs
# Le fichier .env NE doit PAS être commité (voir .gitignore)

# Port exposé pour OpenWebUI
OPENWEBUI_PORT=3000

# Port exposé pour l'API Ollama (optionnel, utile pour accès externe)
OLLAMA_PORT=11434

# Tag de l'image OpenWebUI — toujours épingler une version précise
OPENWEBUI_IMAGE_TAG=0.10.0

# Tag de l'image Ollama — épingler une version précise recommandé
OLLAMA_IMAGE_TAG=0.3.14

# Clé secrète pour les sessions OpenWebUI (changer en production)
WEBUI_SECRET_KEY=changeme_secret_key_here

# URL de base Ollama vue depuis OpenWebUI (ne pas modifier sauf architecture custom)
OLLAMA_BASE_URL=http://ollama:11434
